{
  "name": "nators-api",
  "version": "1.0.0",
  "description": "A Node.js API for the Nators application",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "data:import": "node utils/import-dev-data.js --import",
    "data:delete": "node utils/import-dev-data.js --delete",
    "watch:js": "esbuild ./public/js/index.js --bundle --outfile=./public/js/bundle.js --watch",
    "build:js": "esbuild ./public/js/index.js --bundle --outfile=./public/js/bundle.js --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-routes-visualizer": "^0.2.4",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "nodemon": "^3.1.14",
    "pug": "^3.0.4",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "superagent": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "esbuild": "^0.28.2",
    "express-middleware-visualizer": "^0.1.3",
    "parcel": "^2.16.4",
    "prettier": "^3.9.10"
  }
}
