header.header
  nav.nav.nav--tours
    a.nav__el(href="/") All tours

    //- form.nav__search
    //-   button.nav__search-btn
    //-     svg
    //-       use(xlink:href="img/icons.svg#icon-search")
    //-   input.nav__search-input(type="text", placeholder="Search tours")

  .header__logo
    a(href="/")
      img(src="/img/logo-green.png", alt="Natours logo")

  nav.nav.nav--user
    if user
      a.nav__el.nav__el--logout Log out
      a.nav__el(href="/me")
        - const photoSrc = user.photo && user.photo.startsWith('http') ? user.photo : `/img/users/${user.photo}`
        img.nav__user-img(
          src=photoSrc,
          alt=`Photo of ${user.name}`
        )
        span= user.name.split(" ")[0]
    else
      a.nav__el(href="/login") Log in
      a.nav__el.nav__el--cta(href="/signup") Sign up
